{$SITE_DOMAIN} {
	import syncloud_tls
	import syncloud_org_robots
	root * /var/www/syncloud.org/current

	handle /api/* {
		reverse_proxy unix//var/www/syncloud.org/api.socket
	}

	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@notfound expression `{err.status_code} == 404`
		handle @notfound {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
