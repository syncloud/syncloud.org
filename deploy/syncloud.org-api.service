[Unit]
Description=syncloud.org api
After=network.target

[Service]
Type=simple
EnvironmentFile=/var/www/syncloud.org/common.env
EnvironmentFile=/var/www/syncloud.org/api.env
User=ubuntu
Group=ubuntu
ExecStart=/var/www/syncloud.org/bin/api --socket /var/www/syncloud.org/api.socket --metrics :9101 --release-base ${RELEASE_BASE} --release-api ${RELEASE_API} --release-cache ${RELEASE_CACHE} --account-url ${ACCOUNT_URL} --platform-version ${PLATFORM_VERSION}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
