[Unit]
Description=syncloud.org api
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/var/www/syncloud.org/bin/api --socket /var/www/syncloud.org/api.socket --metrics :9101 --www /var/www/syncloud.org/current
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
